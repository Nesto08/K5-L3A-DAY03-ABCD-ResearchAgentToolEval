# Day 03 Lab v2 — Research Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Model provider (điền key nào có cũng được, ít nhất một) ---
# `--provider auto` và UI chỉ dùng provider có key ở đây, thử theo LAB_PROVIDER_ORDER.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Provider UI chọn sẵn (auto | gemini | openai | openrouter | anthropic | groq | ollama)
# LAB_PROVIDER=auto
# Thứ tự `auto` thử; provider đầu lỗi hoặc hết quota thì chuyển sang provider sau
# LAB_PROVIDER_ORDER=gemini,openai,openrouter,anthropic,groq,ollama

# --- Local small model (bonus challenge, no key needed) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# --- Research / read tools ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
ARXIV_USER_AGENT=AI20k-Day03-Research-Agent/1.0 (educational lab)

# --- Bonus delivery (optional, advanced track) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
